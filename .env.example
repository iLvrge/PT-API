HOST=XXX
# MySQL port. Set this when MySQL is reached through a tunnel or proxy that
# does not sit on 3306. Defaults to 3306 when unset.
DB_PORT=3306
# NOTE: USER collides with the POSIX shell variable of the same name. If the
# process inherits a shell USER, make sure the .env value wins (env-cmd without
# --no-override does this) or the app connects as the wrong database user.
USER=XXX
DATABASE_APPLICATION=XXX
DATABASE_APPLICATION_NEW=XXX
DATABASE_BUSINESS=XXX
DATABASE_RAW=XXX
DATABASE_MAINTAINENCE=XXX
DATABASE_APPLICATION_BIBLIO=XXX
DATABASE_GRANT_BIBLIO=XXX
PASSWORD=XXX
PORT=XXX
DIALECT=XXX
HANDLEDISCONNECT=true
MAX=100
MIN=1
ACQUIRE=1000000
IDLE=5000
EPO_KEY=XXX
EPO_SECRET=XXX
BACKGROUND_JOB_URL=XXX
MAIN_FOLDER_PATH=XXX
SCRIPT_PATH=XXX
EXTRA_DISK_PATH=XXX
JSON_GENERATE=XXX
BUCKET_ACCESS_KEY=XXX
BUCKET_SECRET_KEY=XXX
BUCKET_REGION=XXX
BUCKET_URL=XXX
BUCKET_PHOTO_DIR=XXX
BUCKET_FIGURES_DIR=XXX
BUCKET_DOCUMENT_DIR=XXX
BUCKET_NAME=XXX
SLACK_CLIENT_ID=XXX
SLACK_CLIENT_SECRET=XXX
GOOGLE_CLIENT_ID=XXX
GOOGLE_SECRET_KEY=XXX
REDIRECT_URL=XXX
GOOGLE_SCOPE=XXX
EMAIL=XXX
EMAIL_APP=XXX
MICROSOFT_SECRET_ID=XXX
MICROSOFT_SECRET_KEY=XXX
MICROSOFT_CLIENT_ID=XXX
MICROSOFT_TENANT_ID=XXX
AWS_ACCESS_KEY_ID=XXX
AWS_SECRET_KEY=XXX
AWS_DEFAULT_REGION=XXX
PATENTS_VIEW_API_KEYS=XXX
ASSIGNMENT_CENTER_SEARCH_URL=XXX
SENTRY_DSN=XXX
NODE_ENV=XXX
STATIC_FILES_URL=XXX
STATIC_FILES_PATENT_IMAGES_URL=XXX
STATIC_FILE_DISC_PATH=XXX
SAVE_TO_LOCAL=XXX
FILE_UPLOAD_MAX_MB=XXX
FILE_UPLOAD_TMP_DIR=XXX
REQUEST_LOG_ENABLED=XXX
REQUEST_LOG_MAX_BYTES=XXX
# ---- v2 (src/) additions ----
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_QUERY_LOG=false
TOKEN_TTL_SECONDS=86400
BCRYPT_ROUNDS=12
CORS_ORIGINS=https://admin.patentrack.com,https://patentrack.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
SENTRY_TRACES_SAMPLE_RATE=0.1

# JWT signing secret. Required - the app refuses to boot without it.
# Rotating it invalidates every issued token.
SECRET=XXX
